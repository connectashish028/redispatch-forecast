# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.ipynb_checkpoints/

# Virtual envs
.venv/
venv/
env/

# IDEs / agent tooling
.vscode/
.idea/
.claude/

# OS
.DS_Store
Thumbs.db

# --- Project data ---
# Use /* (not trailing slash) so git descends and the ! exceptions take effect.
data/raw/*
data/external/*
data/processed/*

# Re-include the SHN chunks subdirectory and its parquet files, so the daily
# refresh workflow can rebuild processed parquets from the full history.
# One-time bootstrap of 1,967 historical chunks (~50 MB) + ~25 KB per day after.
!data/raw/shn_operations_last_2y/
data/raw/shn_operations_last_2y/*
!data/raw/shn_operations_last_2y/chunk_*.parquet

# Re-include the small processed files the dashboard needs to start cold.
!data/external/towns_geo.parquet
!data/external/shn_grid.geojson
!data/processed/ts_15min_wide.parquet
!data/processed/ts_15min_long.parquet

# Trained models. The boosters + calibrators are committed so the daily
# refresh workflow on GitHub Actions can run inference without a separate
# training step. Combined size ~280 KB — small enough.
models/*
!models/feature_importance_y_*.csv
!models/feature_cols.json
!models/metrics.json
!models/model_y_*.txt
!models/calibrator_y_*.joblib

# Daily prediction outputs (regenerable from src/v2/score_today.py).
# Per-day parquets are large (~600 KB × 800+ days = ~500 MB); we keep them
# local + in CI runners only. The dashboard's "Why?" panel reads the rolled-up
# daily summary, which we DO commit (built by src/build_daily_summary.py).
data/predictions/*
!data/predictions/contributions_daily_summary.parquet
app_test.py

# Loose artifacts dropped at the project root by older runs
/ts_15min*.parquet
/redispatch_map.html
/redispatch_animation.html
/backfill.log

# Local design doc — not part of the public repo
/THEME.md

# Jupyter outputs (keep notebooks lean)
*-checkpoint.ipynb

# v2 inference + training pipeline is now production code (used by the daily
# refresh workflow). Notebooks stay local — too noisy for git.
notebooks/v2/
