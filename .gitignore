# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.ipynb_checkpoints/

# Virtual envs
.venv/
venv/
env/

# IDEs / agent tooling
.vscode/
.idea/
.claude/

# OS
.DS_Store
Thumbs.db

# --- Project data ---
# Use /* (not trailing slash) so git descends and the ! exceptions take effect.
data/raw/*
data/external/*
data/processed/*

# Re-include the SHN chunks subdirectory and its parquet files, so the daily
# refresh workflow can rebuild processed parquets from the full history.
# One-time bootstrap of 1,967 historical chunks (~50 MB) + ~25 KB per day after.
!data/raw/shn_operations_last_2y/
data/raw/shn_operations_last_2y/*
!data/raw/shn_operations_last_2y/chunk_*.parquet

# Re-include the small processed files the dashboard needs to start cold.
!data/external/towns_geo.parquet
!data/processed/ts_15min_wide.parquet
!data/processed/ts_15min_long.parquet

# Trained models can be regenerated from src/train.py
models/

# Daily prediction outputs (regenerable from src/score_today.py)
data/predictions/
app_test.py

# Loose artifacts dropped at the project root by older runs
/ts_15min*.parquet
/redispatch_map.html
/redispatch_animation.html

# Jupyter outputs (keep notebooks lean)
*-checkpoint.ipynb

# v2 work-in-progress (kept local only)
src/v2/
notebooks/v2/
